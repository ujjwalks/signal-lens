{
  "domain": "finboard.ai",
  "profile": "tests/fixtures/profile-good.json",
  "signals": [
    {
      "signal": "has a quote in hand and is asking strangers to sanity-check it",
      "library_type": "second opinion / pre-commitment",
      "surface": [
        "r/Accounting",
        "r/QuickBooks",
        "r/bookkeeping",
        "r/CPA",
        "r/FPandA"
      ],
      "observable": "post_body",
      "method": "keyword",
      "query": {
        "any_of": [
          "quoted us",
          "wants $",
          "is this a fair price",
          "talk me out of",
          "am I being overcharged"
        ],
        "near": [
          "Fathom",
          "LiveFlow",
          "Cube",
          "Vena",
          "Spotlight Reporting"
        ],
        "window_tokens": 30
      },
      "must_also_have": {
        "count_of": "legal entities",
        "demand_side": true,
        "date_from_text": true,
        "numeric_pattern": "[\\$£€]\\s?[\\d,]{3,}",
        "date_pattern": "\\d+\\s*(day|week|month)"
      },
      "disqualifiers": [
        "past tense — 'I paid' rather than 'they want', which means the decision is over",
        "a vendor farming the thread with a counter-quote"
      ],
      "baseline": {
        "required": false
      },
      "freshness_days": 21,
      "yields": {
        "entity": "the poster's employer",
        "contactable": "sometimes"
      },
      "rank": {
        "stage": 4,
        "evidence_density": 3,
        "separability": 2,
        "reach": 0,
        "contestedness": 0
      }
    },
